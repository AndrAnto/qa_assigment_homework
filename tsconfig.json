{
  "compilerOptions": {
    "target": "es2019",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["es2019", "dom"],
    "types": ["cypress", "node", "@shelex/cypress-allure-plugin"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["cypress/**/*.ts", "cypress/**/*.json", "cypress.config.ts"]
}
